{
  "name": "@verified-attention/ml-serving-fraud",
  "version": "0.1.0-dev",
  "description": "Fraud model serving app: HTTP /predict endpoint and gRPC service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@verified-attention/core": "workspace:*",
    "@verified-attention/ml-fraud-ensemble": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsdown": "^0.11.0",
    "vitest": "^2.0.0"
  }
}
