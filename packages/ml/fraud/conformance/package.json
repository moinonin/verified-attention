{
  "name": "@verified-attention/ml-fraud-conformance",
  "version": "0.1.0-dev",
  "description": "Conformance determinism tests for fraud detection packages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "echo \"test-only package, no build needed\"",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@verified-attention/ml-fraud-biometrics": "workspace:*",
    "@verified-attention/ml-fraud-fingerprint": "workspace:*",
    "@verified-attention/ml-fraud-automation": "workspace:*",
    "@verified-attention/ml-fraud-sybil": "workspace:*",
    "@verified-attention/ml-fraud-reputation": "workspace:*",
    "@verified-attention/ml-fraud-ensemble": "workspace:*",
    "@verified-attention/core": "workspace:*",
    "@verified-attention/verification": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsdown": "^0.11.0",
    "vitest": "^2.0.0"
  }
}
